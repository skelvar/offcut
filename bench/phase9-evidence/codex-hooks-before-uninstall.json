{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/post-write.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/activate.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/session-end.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/prompt.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/subagent.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/.worktrees/phase-9-coexistence/hooks/pre-write.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ]
  }
}