-export function reserveInventory(): unknown {
-  throw new Error('not ready');
+export interface InventoryReservation {
+  allocated: Record<string, number>;
+  remaining: Record<string, number>;
+}
+
+export function reserveInventory(
+  stock: Readonly<Record<string, number>>,
+  requests: Readonly<Record<string, number>>,
+): InventoryReservation {
+  const allocated: Record<string, number> = {};
+  const remaining: Record<string, number> = { ...stock };
+
+  for (const [sku, requestedQuantity] of Object.entries(requests)) {
+    if (requestedQuantity <= 0) {
+      continue;
+    }
+
+    const availableQuantity = Math.max(stock[sku] ?? 0, 0);
+    const allocatedQuantity = Math.min(requestedQuantity, availableQuantity);
+
+    allocated[sku] = allocatedQuantity;
+    if (Object.prototype.hasOwnProperty.call(stock, sku)) {
+      remaining[sku] = stock[sku] - allocatedQuantity;
+    }
+  }
+
+  return { allocated, remaining };
 }
