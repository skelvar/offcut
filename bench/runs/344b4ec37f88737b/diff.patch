new file mode 100644
index 0000000..092bc8e
--- /dev/null
+++ b/slug/Slugifier.js
@@ -0,0 +1,14 @@
+export class Slugifier {
+  slugify(text) {
+    if (typeof text !== 'string') throw new TypeError('text must be a string');
+    return text
+      .toLowerCase()
+      .replace(/\s+/g, '-')
+      .replace(/[^a-z0-9-]/g, '')
+      .replace(/-+/g, '-')
+      .replace(/^-|-$/g, '');
+  }
+}
+export function createSlugifier() {
+  return new Slugifier();
+}
