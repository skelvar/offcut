+function sleep(ms) {
+  return new Promise((r) => setTimeout(r, ms));
+}
+
+export async function retry(fn, { retries = 3, delayMs = 10 } = {}) {
+  let last;
+  for (let attempt = 0; attempt <= retries; attempt++) {
+    try {
+      return await fn();
+    } catch (e) {
+      last = e;
+      if (attempt === retries) break;
+      await sleep(delayMs * (attempt + 1));
+    }
+  }
+  throw last;
+}
