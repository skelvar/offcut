@@ -1,3 +1,56 @@
-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const rows = parseCsv(csv);
+  const totals = new Map();
+
+  for (const [region = '', amountText = ''] of rows.slice(1)) {
+    if (region.trim() === '' && amountText.trim() === '') continue;
+
+    const amount = Number(amountText.trim());
+    if (!Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${amountText}`);
+    }
+
+    totals.set(region, (totals.get(region) ?? 0) + amount);
+  }
+
+  return Object.fromEntries(totals);
+}
+
+function parseCsv(csv) {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < csv.length; index += 1) {
+    const character = csv[index];
+
+    if (character === '"') {
+      if (quoted && csv[index + 1] === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (character === ',' && !quoted) {
+      row.push(field);
+      field = '';
+    } else if ((character === '\n' || character === '\r') && !quoted) {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+
+      if (character === '\r' && csv[index + 1] === '\n') index += 1;
+    } else {
+      field += character;
+    }
+  }
+
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  return rows;
 }
