+import { readFileSync, existsSync } from 'node:fs';
+
+const defaults = { port: 3000, host: 'localhost' };
+
+export function loadConfig() {
+  let fileConfig = {};
+  if (existsSync('config.json')) {
+    fileConfig = JSON.parse(readFileSync('config.json', 'utf8'));
+  }
+
+  const envConfig = {};
+  if (process.env.APP_PORT !== undefined) envConfig.port = process.env.APP_PORT;
+  if (process.env.APP_HOST !== undefined) envConfig.host = process.env.APP_HOST;
+
+  return { ...defaults, ...fileConfig, ...envConfig };
+}
