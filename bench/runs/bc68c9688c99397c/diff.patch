-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const rows = parseCsv(csv);
+  const totals = {};
+
+  for (const row of rows.slice(1)) {
+    if (row.length === 1 && row[0].trim() === '') continue;
+
+    const amount = Number(row[1]);
+    if (row.length !== 2 || row[1].trim() === '' || !Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${row[1] ?? ''}`);
+    }
+
+    const region = row[0];
+    const current = Object.prototype.hasOwnProperty.call(totals, region)
+      ? totals[region]
+      : 0;
+
+    Object.defineProperty(totals, region, {
+      configurable: true,
+      enumerable: true,
+      value: current + amount,
+      writable: true,
+    });
+  }
+
+  return totals;
+}
+
+function parseCsv(csv) {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < csv.length; index += 1) {
+    const character = csv[index];
+
+    if (character === '"') {
+      if (quoted && csv[index + 1] === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (character === ',' && !quoted) {
+      row.push(field);
+      field = '';
+    } else if ((character === '\n' || character === '\r') && !quoted) {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+
+      if (character === '\r' && csv[index + 1] === '\n') index += 1;
+    } else {
+      field += character;
+    }
+  }
+
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  return rows;
 }
