{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/hooks/activate.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/hooks/prompt.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/hooks/subagent.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/hooks/pre-write.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/rightseam/hooks/post-write.js\"",
            "timeout": 5,
            "statusMessage": "offcut-hooks"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}