+function wait(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
 }
+
+export async function retry(fn, { retries = 3, delayMs = 10 } = {}) {
+  let attempt = 0;
+  for (;;) {
+    try {
+      return await fn();
+    } catch (err) {
+      attempt++;
+      if (attempt > retries) throw err;
+      await wait(delayMs * attempt);
+    }
+  }
+}
