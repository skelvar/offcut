-// TODO: implement slugify()
-export function slugify(_text) {
-  throw new Error('not implemented');
+export function slugify(text) {
+  if (typeof text !== 'string') throw new TypeError('text must be a string');
+  return text
+    .toLowerCase()
+    .replace(/\s+/g, '-')
+    .replace(/[^a-z0-9-]/g, '')
+    .replace(/-+/g, '-')
+    .replace(/^-+|-+$/g, '');
 }
