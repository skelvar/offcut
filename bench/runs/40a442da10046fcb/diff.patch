-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const totals = new Map();
+  // offcut: rows are line-oriented; use a full CSV parser if regions may contain newlines.
+  const rows = csv.split(/\r?\n/);
+
+  for (const row of rows.slice(1)) {
+    if (row.trim() === '') continue;
+
+    let region;
+    let amountText;
+
+    if (row.startsWith('"')) {
+      let end = 1;
+      let value = '';
+
+      while (end < row.length) {
+        if (row[end] !== '"') {
+          value += row[end++];
+        } else if (row[end + 1] === '"') {
+          value += '"';
+          end += 2;
+        } else {
+          break;
+        }
+      }
+
+      region = value;
+      amountText = row[end + 1] === ',' ? row.slice(end + 2) : undefined;
+    } else {
+      const comma = row.indexOf(',');
+      region = row.slice(0, comma);
+      amountText = comma === -1 ? undefined : row.slice(comma + 1);
+    }
+
+    const amount = Number(amountText);
+    if (amountText?.trim() === '' || !Number.isFinite(amount)) {
+      throw new TypeError(`Invalid amount for region ${region}`);
+    }
+
+    totals.set(region, (totals.get(region) ?? 0) + amount);
+  }
+
+  return Object.fromEntries(totals);
 }
