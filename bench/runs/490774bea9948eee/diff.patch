-export function reserveInventory(): unknown {
-  throw new Error('not ready');
+export type Inventory = Record<string, number>;
+
+export interface Reservation {
+  allocated: Inventory;
+  remaining: Inventory;
+}
+
+export function reserveInventory(
+  stock: Readonly<Inventory>,
+  requests: Readonly<Inventory>,
+): Reservation {
+  const allocated: Inventory = {};
+  const remaining: Inventory = { ...stock };
+
+  for (const [sku, requested] of Object.entries(requests)) {
+    if (requested <= 0) continue;
+
+    const available = Math.max(0, stock[sku] ?? 0);
+    const quantity = Math.min(requested, available);
+
+    allocated[sku] = quantity;
+    if (Object.prototype.hasOwnProperty.call(stock, sku)) {
+      remaining[sku] = stock[sku] - quantity;
+    }
+  }
+
+  return { allocated, remaining };
 }
