-export function formatOrderLabel() {
-  throw new Error('not ready');
+export function formatOrderLabel(order) {
+  const id = typeof order?.id === 'string' ? order.id.trim() : '';
+  const customer = typeof order?.customer === 'string'
+    ? order.customer.trim()
+    : '';
+
+  if (!id || !customer) {
+    throw new TypeError('Order id and customer are required');
+  }
+
+  return `#${id} — ${customer.toUpperCase()}`;
 }
