-export function reserveInventory(): unknown {
-  throw new Error('not ready');
+export function reserveInventory(
+  stock: Record<string, number>,
+  requests: Record<string, number>,
+): { allocated: Record<string, number>; remaining: Record<string, number> } {
+  const allocated: Record<string, number> = {};
+  const remaining = { ...stock };
+
+  for (const [sku, requestedQuantity] of Object.entries(requests)) {
+    if (requestedQuantity <= 0) {
+      continue;
+    }
+
+    const currentQuantity = remaining[sku] ?? 0;
+    const availableQuantity = Math.max(0, currentQuantity);
+    const allocatedQuantity = Math.min(requestedQuantity, availableQuantity);
+
+    allocated[sku] = allocatedQuantity;
+    if (sku in remaining) {
+      remaining[sku] = currentQuantity - allocatedQuantity;
+    }
+  }
+
+  return { allocated, remaining };
 }
