diff --git a/cache/Entry.js b/cache/Entry.js
new file mode 100644
index 0000000..33a0968
--- /dev/null
+++ b/cache/Entry.js
@@ -0,0 +1,7 @@
+export class CacheEntry {
+  constructor(value, expiresAt) {
+    this.value = value;
+    this.expiresAt = expiresAt;
+  }
+  isExpired(now) { return now > this.expiresAt; }
+}
diff --git a/cache/Store.js b/cache/Store.js
new file mode 100644
index 0000000..382e5f2
--- /dev/null
+++ b/cache/Store.js
@@ -0,0 +1,6 @@
+export class MapStore {
+  constructor() { this.map = new Map(); }
+  get(k) { return this.map.get(k); }
+  set(k, v) { this.map.set(k, v); }
+  delete(k) { this.map.delete(k); }
+}
