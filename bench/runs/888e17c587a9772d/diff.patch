-export function reserveInventory(): unknown {
-  throw new Error('not ready');
+export function reserveInventory(
+  stock: Record<string, number>,
+  requests: Record<string, number>,
+): { allocated: Record<string, number>; remaining: Record<string, number> } {
+  const remaining = { ...stock };
+  const allocations: Array<[string, number]> = [];
+
+  for (const [sku, requested] of Object.entries(requests)) {
+    if (requested <= 0) continue;
+
+    const stocked = Object.hasOwn(stock, sku);
+    const available = stocked ? Math.max(0, stock[sku]) : 0;
+    const quantity = Math.min(requested, available);
+
+    allocations.push([sku, quantity]);
+    if (stocked) remaining[sku] = stock[sku] - quantity;
+  }
+
+  return { allocated: Object.fromEntries(allocations), remaining };
 }
