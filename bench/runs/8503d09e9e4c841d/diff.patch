-export function formatOrderLabel() {
-  throw new Error('not ready');
+export function formatOrderLabel(order) {
+  const id = order?.id;
+  const customer = order?.customer;
+
+  if (
+    typeof id !== 'string' ||
+    typeof customer !== 'string' ||
+    id.trim() === '' ||
+    customer.trim() === ''
+  ) {
+    throw new TypeError('order.id and order.customer are required');
+  }
+
+  return `#${id.trim()} — ${customer.trim().toUpperCase()}`;
 }
