-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const totals = new Map();
+  const rows = csv.split(/\r?\n/);
+
+  // offcut: records are line-based; add a full CSV parser if regions may contain newlines.
+  for (const row of rows.slice(1)) {
+    if (row.trim() === '') continue;
+
+    let region;
+    let amountText;
+
+    if (row.startsWith('"')) {
+      const match = row.match(/^"((?:[^"]|"")*)",(.*)$/);
+      if (match) {
+        region = match[1].replace(/""/g, '"');
+        amountText = match[2];
+      }
+    } else {
+      const separator = row.indexOf(',');
+      if (separator !== -1) {
+        region = row.slice(0, separator);
+        amountText = row.slice(separator + 1);
+      }
+    }
+
+    const amount = Number(amountText);
+    if (!Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${amountText}`);
+    }
+
+    totals.set(region, (totals.get(region) ?? 0) + amount);
+  }
+
+  return Object.fromEntries(totals);
 }
