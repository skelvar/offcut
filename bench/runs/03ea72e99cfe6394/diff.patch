-export function summarizeSales() {
-  throw new Error('not ready');
+function parseCsv(csv) {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < csv.length; index += 1) {
+    const character = csv[index];
+
+    if (quoted) {
+      if (character === '"') {
+        if (csv[index + 1] === '"') {
+          field += '"';
+          index += 1;
+        } else {
+          quoted = false;
+        }
+      } else {
+        field += character;
+      }
+    } else if (character === '"' && field.length === 0) {
+      quoted = true;
+    } else if (character === ',') {
+      row.push(field);
+      field = '';
+    } else if (character === '\n' || character === '\r') {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+
+      if (character === '\r' && csv[index + 1] === '\n') {
+        index += 1;
+      }
+    } else {
+      field += character;
+    }
+  }
+
+  if (field.length > 0 || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  return rows;
+}
+
+export function summarizeSales(csv) {
+  const totals = {};
+  const rows = parseCsv(csv);
+
+  for (const row of rows.slice(1)) {
+    if (row.every((field) => field.trim() === '')) {
+      continue;
+    }
+
+    const [region, amountText] = row;
+    const amount = Number(amountText);
+
+    if (amountText == null || amountText.trim() === '' || !Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${amountText}`);
+    }
+
+    const previousTotal = Object.hasOwn(totals, region) ? totals[region] : 0;
+    Object.defineProperty(totals, region, {
+      configurable: true,
+      enumerable: true,
+      value: previousTotal + amount,
+      writable: true,
+    });
+  }
+
+  return totals;
 }
