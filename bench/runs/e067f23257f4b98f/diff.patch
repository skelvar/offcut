diff --git a/validation/EmailValidator.js b/validation/EmailValidator.js
new file mode 100644
index 0000000..68e4e5d
--- /dev/null
+++ b/validation/EmailValidator.js
@@ -0,0 +1,21 @@
+import { Validator } from './Validator.js';
+
+export class EmailValidator extends Validator {
+  validate(email) {
+    if (typeof email !== 'string') return false;
+    const i = email.indexOf('@');
+    if (i <= 0) return false;
+    const local = email.slice(0, i);
+    const domain = email.slice(i + 1);
+    if (!local || !domain || domain.includes('@')) return false;
+    return domain.includes('.');
+  }
+}
+
+export function createEmailValidator() {
+  return new EmailValidator();
+}
+
+export function unusedPhoneValidator() {
+  return { validate: () => false };
+}
