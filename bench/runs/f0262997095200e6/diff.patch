@@ -0,0 +1,10 @@
+import { ConfigProvider } from './types.js';
+
+export class EnvConfigSource extends ConfigProvider {
+  load() {
+    const out = {};
+    if (process.env.APP_PORT) out.port = Number(process.env.APP_PORT);
+    if (process.env.APP_HOST) out.host = process.env.APP_HOST;
+    return out;
+  }
+}
