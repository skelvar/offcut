-export function safeFilename() {
-  throw new Error('not ready');
+export function safeFilename(name) {
+  const filename = name
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9._-]+/g, '-')
+    .replace(/-+/g, '-')
+    .replace(/^[.-]+|[.-]+$/g, '');
+
+  if (filename.length === 0) {
+    throw new TypeError('Filename must contain at least one valid character');
+  }
+
+  return filename;
 }
