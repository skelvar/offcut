+function wait(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function retry(fn, { retries = 3, delayMs = 10 } = {}) {
+  let attempt = 0;
+  while (true) {
+    try {
+      return await fn();
+    } catch (err) {
+      attempt += 1;
+      if (attempt > retries) throw err;
+      await wait(delayMs * attempt);
+    }
+  }
+}
+
+export default retry;
+export { retry };
