-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const rows = parseCsv(csv);
+  const totals = {};
+
+  for (const row of rows.slice(1)) {
+    if (row.length === 1 && row[0].trim() === '') continue;
+
+    const region = row[0];
+    const amount = Number(row[1]);
+
+    if (!Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${row[1] ?? ''}`);
+    }
+
+    const previous = Object.prototype.hasOwnProperty.call(totals, region)
+      ? totals[region]
+      : 0;
+    Object.defineProperty(totals, region, {
+      value: previous + amount,
+      enumerable: true,
+      configurable: true,
+      writable: true,
+    });
+  }
+
+  return totals;
+}
+
+function parseCsv(csv) {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < csv.length; index += 1) {
+    const character = csv[index];
+
+    if (quoted) {
+      if (character === '"') {
+        if (csv[index + 1] === '"') {
+          field += '"';
+          index += 1;
+        } else {
+          quoted = false;
+        }
+      } else {
+        field += character;
+      }
+    } else if (character === '"' && field === '') {
+      quoted = true;
+    } else if (character === ',') {
+      row.push(field);
+      field = '';
+    } else if (character === '\n' || character === '\r') {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+      if (character === '\r' && csv[index + 1] === '\n') index += 1;
+    } else {
+      field += character;
+    }
+  }
+
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  return rows;
 }
