-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < csv.length; index += 1) {
+    const character = csv[index];
+
+    if (character === '"') {
+      if (quoted && csv[index + 1] === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (character === ',' && !quoted) {
+      row.push(field);
+      field = '';
+    } else if ((character === '\n' || character === '\r') && !quoted) {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+
+      if (character === '\r' && csv[index + 1] === '\n') {
+        index += 1;
+      }
+    } else {
+      field += character;
+    }
+  }
+
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+
+  const totals = {};
+
+  for (const fields of rows.slice(1)) {
+    if (fields.every((value) => value.trim() === '')) {
+      continue;
+    }
+
+    const [region, amountText] = fields;
+    const amount = Number(amountText);
+
+    if (!Number.isFinite(amount)) {
+      throw new TypeError('Sales amount must be finite');
+    }
+
+    const currentTotal = Object.hasOwn(totals, region) ? totals[region] : 0;
+    Object.defineProperty(totals, region, {
+      configurable: true,
+      enumerable: true,
+      value: currentTotal + amount,
+      writable: true,
+    });
+  }
+
+  return totals;
 }
