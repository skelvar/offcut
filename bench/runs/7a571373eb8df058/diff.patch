@@ -1,3 +1,57 @@
-export function summarizeSales() {
-  throw new Error('not ready');
+function parseRow(row) {
+  const fields = [];
+  let field = '';
+  let quoted = false;
+
+  for (let index = 0; index < row.length; index += 1) {
+    const character = row[index];
+
+    if (character === '"') {
+      if (quoted && row[index + 1] === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (character === ',' && !quoted) {
+      fields.push(field);
+      field = '';
+    } else {
+      field += character;
+    }
+  }
+
+  fields.push(field);
+  return fields;
+}
+
+export function summarizeSales(csv) {
+  const totals = {};
+  const rows = csv.split(/\r?\n/);
+
+  for (const row of rows.slice(1)) {
+    if (row.trim() === '') {
+      continue;
+    }
+
+    const [region, rawAmount] = parseRow(row);
+    const amount = Number(rawAmount);
+
+    if (!Number.isFinite(amount)) {
+      throw new TypeError(`Invalid sales amount: ${rawAmount}`);
+    }
+
+    if (Object.hasOwn(totals, region)) {
+      totals[region] += amount;
+    } else {
+      Object.defineProperty(totals, region, {
+        value: amount,
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+  }
+
+  return totals;
 }
