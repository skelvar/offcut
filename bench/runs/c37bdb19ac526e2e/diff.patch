-export function summarizeSales() {
-  throw new Error('not ready');
+export function summarizeSales(csv) {
+  const totals = {};
+  // offcut: rows are physical lines; use a full CSV parser if regions may contain newlines.
+  const rows = csv.split(/\r?\n/);
+
+  for (const row of rows.slice(1)) {
+    if (row.trim() === '') continue;
+
+    const match = row.match(/^(?:"((?:[^"]|"")*)"|([^,]*)),(.*)$/);
+    const region = match?.[1] !== undefined
+      ? match[1].replace(/""/g, '"')
+      : match?.[2];
+    const amount = Number(match?.[3]);
+
+    if (!Number.isFinite(amount)) {
+      throw new TypeError('Sales amount must be finite');
+    }
+
+    const previous = Object.hasOwn(totals, region) ? totals[region] : 0;
+    Object.defineProperty(totals, region, {
+      configurable: true,
+      enumerable: true,
+      value: previous + amount,
+      writable: true,
+    });
+  }
+
+  return totals;
 }
